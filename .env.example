# Supabase configuration — copy this file to `.env` and fill in real values.
# The anon (publishable) key is safe to embed in the client app.
# NEVER put a service-role key in this file or anywhere in the Flutter app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
